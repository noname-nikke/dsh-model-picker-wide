{
  "name": "dsh-model-picker-wide",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Widen the DSH composer model picker so long model names with provider or version suffixes are shown in full. 加宽 DSH 输入框的模型选择器，长模型名不再被截断。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "ui",
    "width",
    "composer"
  ],
  "license": "MIT",
  "author": "noname-nikke",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noname-nikke/dsh-model-picker-wide.git"
  },
  "bugs": {
    "url": "https://github.com/noname-nikke/dsh-model-picker-wide/issues"
  },
  "homepage": "https://github.com/noname-nikke/dsh-model-picker-wide#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
